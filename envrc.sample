export EPHEMERA_LAMBDA_ROLE_ARN=""
export EPHEMERA_FUNCTION_NAME=""

# hosts.json と authorities.json を置く設定用のバケット（S3 Express One Zone のディレクトリバケット）。読むだけ
export EPHEMERA_S3_EXPRESS_BUCKET_NAME=""
export EPHEMERA_HOST_SUFFIX=""
export EPHEMERA_AUTH_SUBDOMAIN=""

export EPHEMERA_SESSION_KEY=""
export EPHEMERA_CLIENT_ID=""
export EPHEMERA_CLIENT_SECRET=""

# 承認方式のログイン（任意）。承認の要求を置くバケットを設定すると有効になる。
# 設定用のバケットとは別の、通常の（汎用）バケットにすること。要求はその approvals/ に置く。
# Lambda ロールに approvals/* への s3:PutObject と s3:GetObject が要る。
# approvals/ を1日で消すライフサイクルルールも設定すること
export EPHEMERA_APPROVAL_BUCKET_NAME=""

# ECS へのデプロイ（task deploy-ecs / diff-ecs / verify-ecs）
export AWS_ACCOUNT_ID=""
export AWS_REGION="ap-northeast-1"
# 秘密の値を置いている SSM パラメータストアのパス（末尾の / なし）
export EPHEMERA_SSM_PREFIX=""
