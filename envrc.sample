# 承認方式のログイン（任意）。true で有効。
# 要求を EPHEMERA_S3_BUCKET_NAME の approvals/ に置くので、Lambda ロールに approvals/* への s3:PutObject が要る。
# approvals/ を1日で消すライフサイクルルールも設定すること
export EPHEMERA_ENABLE_APPROVAL="false"

# ECS へのデプロイ（task deploy-ecs / diff-ecs / verify-ecs）
export AWS_ACCOUNT_ID=""
export AWS_REGION="ap-northeast-1"
# 秘密の値を置いている SSM パラメータストアのパス（末尾の / なし）
export EPHEMERA_SSM_PREFIX=""
