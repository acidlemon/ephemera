export EPHEMERA_S3_BUCKET_NAME=""
export EPHEMERA_HOST_SUFFIX=""
export EPHEMERA_AUTH_SUBDOMAIN=""

export EPHEMERA_SESSION_KEY=""
export EPHEMERA_CLIENT_ID=""
